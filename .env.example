# Optional. Without it the agent uses its built-in rules and templates.
ANTHROPIC_API_KEY=
# Optional: override the model (see https://platform.claude.com/docs/en/about-claude/models/overview)
ANTHROPIC_MODEL=claude-sonnet-5-5
# Who should own a child account when it differs from the parent's owner:
#   parent_wins  = propose moving the child to the parent's owner (default)
#   flag_only    = list the mismatch but propose no move
OWNERSHIP_RULE=parent_wins
# Lowest confidence (0-1) for a parent link to go in the import file. Anything below goes to review.
AUTO_WRITE_MIN=0.9
